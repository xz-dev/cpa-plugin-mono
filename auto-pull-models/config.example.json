{
  "interval": "1h",
  "management_base_url": "http://127.0.0.1:8317",
  "management_key_env": "",
  "management_key_file": "/CLIProxyAPI/mgmt.key",
  "keep_existing_aliases": true,
  "providers": {
    "openrouter": {
      "enabled": true,
      "mode": "include",
      "patterns": ["^openai/", "^anthropic/", "gpt-"],
      "upstream_meta": true
    },
    "ZCode": {
      "enabled": true,
      "mode": "exclude",
      "patterns": [],
      "codex_manifest": true,
      "upstream_meta": true,
      "modelsdev": true
    }
  }
}
